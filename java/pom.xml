<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = Project Object Model do Maven.

  Este arquivo descreve como o projeto Java e identificado, quais
  dependencias utiliza, qual versao da linguagem deve ser usada e como
  gerar o arquivo JAR executavel.

  O estudante normalmente nao precisa alterar este arquivo para realizar
  os laboratorios da M1.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <!-- Versao do modelo de POM interpretado pelo Maven. -->
  <modelVersion>4.0.0</modelVersion>

  <!-- Identificacao do projeto dentro do ecossistema Maven. -->
  <groupId>br.univali.pdi</groupId>
  <artifactId>pdi-lab</artifactId>
  <version>0.2.0</version>

  <properties>
    <!-- O projeto-base utiliza recursos disponiveis a partir do Java 17. -->
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Mantem os arquivos-fonte e recursos em UTF-8. -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      OpenCV para aplicacoes Java desktop.
      Esta dependencia fornece os bindings Java e as bibliotecas nativas
      necessarias para carregar e salvar imagens.

      O uso da biblioteca como infraestrutura nao autoriza substituir os
      algoritmos avaliados por funcoes prontas equivalentes.
    -->
    <dependency>
      <groupId>org.openpnp</groupId>
      <artifactId>opencv</artifactId>
      <version>4.9.0-0</version>
    </dependency>

    <!--
      JUnit e utilizado exclusivamente para os testes automatizados.
      scope=test impede que ele seja tratado como dependencia da aplicacao.
    -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Nome final esperado em target/pdi-lab.jar. -->
    <finalName>pdi-lab</finalName>

    <plugins>
      <!-- Compila o codigo-fonte usando a versao Java indicada acima. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>

      <!--
        Gera um JAR executavel contendo tambem as dependencias necessarias.
        Ao final de mvn package, o arquivo target/pdi-lab.jar pode ser
        executado diretamente com java -jar.

        ManifestResourceTransformer registra a classe Main no manifesto.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>br.univali.pdi.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
